# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mining-pool

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Pool Configuration
POOL_NAME=LuckyBet Mining Pool
POOL_FEE=1.0
MIN_PAYMENT=0.01
PAYOUT_SCHEME=pplns
PAYMENT_INTERVAL=3600000

# Stratum Server Ports
STRATUM_PORT_SHA256=3333
STRATUM_PORT_SHA256_LOW=3334
STRATUM_PORT_SHA256_MEDIUM=3335
STRATUM_PORT_SHA256_HIGH=3336
STRATUM_PORT_ETHASH=8008

# Coin Nodes
BITCOIN_NODE=http://btcuser:btcpassword@127.0.0.1:8332
ETHEREUM_NODE=http://127.0.0.1:8545

# Solo Mining Configuration
SOLO_MINING_ENABLED=true
SOLO_MINING_PORT_SHA256=4444
SOLO_MINING_PORT_ETHASH=9009

# Admin Email
ADMIN_EMAIL=admin@luckybet.com